# DriveGuard Environment Configuration Example
# Copy to .env.local for local overrides. Do not commit .env or .env.local to version control.

# Application Identity
NEXT_PUBLIC_APP_NAME="DriveGuard"
NEXT_PUBLIC_APP_VERSION="0.1.0"
NEXT_PUBLIC_ENVIRONMENT="development"

# Detection Pipeline Configuration
NEXT_PUBLIC_DETECTION_MODE="client" # Options: "client" (MediaPipe WebAssembly), "hybrid"
NEXT_PUBLIC_ENABLE_AUDIO_CHIMES="true"
NEXT_PUBLIC_PRIVACY_LOCAL_ONLY="true"
NEXT_PUBLIC_DEFAULT_CAMERA_FPS="30"

# Server Port
PORT=3000
